__pycache__/
*.py[cod]
.pytest_cache/
.venv/
/.cuda-12.1/
/.local/
/releases/
*.pt
*.safetensors
*.bin
*.log
*.zip

# Keep generated runs local; explicitly archive complete formal batches.
results/*
!results/reproduction/
results/reproduction/*
!results/reproduction/README.md
!results/reproduction/20261013T060232923276Z/

# Explicitly publish verified Mistral batches, keeping future runs local.
!results/mistral/
results/mistral/*
!results/mistral/README.md
!results/mistral/latest
!results/mistral/20261024T064543Z/
!results/mistral/20261024T064543Z/*.log
!results/mistral/20261024T064353Z/
!results/mistral/20261024T064353Z/*.log
!results/latest-mistral

# Publish this report bundle; new generated bundles need an explicit archive decision.
/reports/*
!/reports/README.md
!/reports/mistral/
/reports/mistral/*
!/reports/mistral/README.md
!/reports/mistral/20261024-mistral7b/
!/reports/mistral/20261024-mistral7b/evidence/*.log

# Verified shared-v2 acceptance batches; future batches remain local.
!results/mistral/small/
results/mistral/small/*
!results/mistral/small/v2-small-final-20261024/
!results/mistral/small/v2-small-final-20261024/**
!results/tinyllama/
results/tinyllama/*
!results/tinyllama/README.md
!results/tinyllama/minimal/
results/tinyllama/minimal/*
!results/tinyllama/minimal/v2-final-check/
!results/tinyllama/minimal/v2-final-check/**
!/reports/mistral/v2-small-final-20261024/
!/reports/mistral/v2-small-final-20261024/**

# Verified shared-v3 mechanism acceptance batches, distinct from v2.
!results/tinyllama/minimal/v3-final-03/
!results/tinyllama/minimal/v3-final-03/**
!results/mistral/minimal/
results/mistral/minimal/*
!results/mistral/minimal/v3-final-03/
!results/mistral/minimal/v3-final-03/**
!/reports/shared-v3-20261025/
!/reports/shared-v3-20261025/**

# Stable large-context readiness and fixed-source acceptance evidence.
!results/mistral/small/v3-larger-validation-03/
!results/mistral/small/v3-larger-validation-03/**
!results/tinyllama/minimal/v3-stable-acceptance-20261025/
!results/tinyllama/minimal/v3-stable-acceptance-20261025/**
!/reports/shared-v3-stable-20261025/
!/reports/shared-v3-stable-20261025/**

# Canonical SQLite databases are archived after checkpoint; sidecars are transient.
**/records.sqlite3-wal
**/records.sqlite3-shm
